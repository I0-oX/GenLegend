// Gen Legend — the whole Home surface: hero, forge card, generate.
// Compiled with @stencil-hq/slab@0.1.0 → app/static/slab/forge.*  (`make slab`);
// mounted by app/static/js/app.js in #view-home. The bridge feeds the option
// lists from GET /api/choices and answers the generate signal against
// POST /api/character/generate.
// Faces are registered by the bridge from app/static/fonts/ (OFL):
// Cinzel for chrome, Eagle Lake for the choices.
//
// Signals: pick carries "category|Name", filter narrows all three lists,
// generate forges the character. The legacy h2/p/tablet chrome is gone —
// this component IS the home page.
//
// House palette (shared by shell / footer / forge / sheet): a papyrus page
// inside a bound-leather grimoire — vellum panels with procedural grain,
// ink-brown text, dark-gilt labels, sealing-wax red for the one loud action.
// Motion: entrances unfurl once (the sheet lays down), hovers pop via
// transitions, loops only while a condition holds (hero rune, FORGING…).

tokens {
  color {
    parch      #DCC49A   // aged page ground (index.html matches)
    vellum     #F1E7CC   // card surface
    raised     #EBDFBC   // option-row hover / picked rows
    well       #DFCB9E   // inset wells (option lists)
    field      #EEE3C2   // input strips sit between card and well
    line       #96794A   // hairline borders
    ochre      #7C4F0E   // labels, carets, gilt accents (dark gold)
    ochreDeep  #5E3B0A   // resting accent stroke
    wax        #9E2B25   // the loud one (sealing wax)
    waxDeep    #7E1F1C   // pressed
    ink        #2B1E12   // primary text
    inkSoft    #483418   // secondary text
  }
  text {
    hero    { family "Cinzel"; size 46; weight 700; tracking 4 }
    tagline { family "Cinzel"; size 15; weight 700; tracking 0.6 }
    label   { family "Cinzel"; size 12; weight 700; tracking 2 }
    opt     { family "Eagle Lake"; size 16; weight 400 }
    meta    { family "Cinzel"; size 12; weight 700; tracking 1.4 }
    field   { family "Eagle Lake"; size 15; weight 400 }
    button  { family "Cinzel"; size 15; weight 700; tracking 2.4 }
    hint    { family "Cinzel"; size 12; weight 700; tracking 1.2 }
  }
  fx {
    // Same ruled wash as the sheet's card — the home writes onto the
    // one parchment, never onto a pasted panel.
    card  { bg linear(180, #F4EBD469 0%, #EADDBA60 100%); radius 4; grain 0.05 }
    well  { bg radial(#E4D2A6E6 0%, #D8C294DE 100%); stroke #96794A; stroke-w 1; radius 6; grain 0.11 }
    pill  { bg #EBDFBC99; stroke #96794A; stroke-w 1; radius 3; grain 0.04 }
    button { bg #9E2B25; radius 4 }
  }
  shadow {
    well inset,0,2,8,#6E52303D
    lift 0,5,14,#8E242659
  }
}

// The sheet lays down onto the table: ink fades in as it settles.
anim unfurl {
  0% { opacity=0; scale=0.97 }
  100% { opacity=1; scale=1 }
}

// The hero seal: a gilt arc sweeps around while the pointer is on it.
anim spin {
  0% { rotate=0 }
  100% { rotate=360 }
}

// The wax seal stamps down when a row becomes picked.
anim pop {
  0% { scale=0.2 }
  70% { scale=1.3 }
  100% { scale=1 }
}

// One option row. The host assigns each item key "category|Name", so a single
// `pick` signal carries both the category and the choice.
def Pick(name="", picked=false) export {
  row w=fill pad=8,12 radius=8 align=center act=pick transition=160,ease-out {
    // Touch devices (coarse pointer) get the 44u touch-target floor; a
    // mouse keeps the tighter 38u row.
    when coarse { pad=11,12 }
    when hover { bg=color.raised scale=1.02 }
    when pressed { opacity=0.8 }
    when focus-visible { stroke=color.ochre stroke-w=2 stroke-align=inside }
    when picked {
      bg=color.vellum
      stroke=color.ochre
      stroke-w=1
      stroke-align=inside
      // The wax seal stamps down the moment the row becomes picked.
      rect w=6 h=6 radius=999 bg=color.wax animate=pop,300,once,ease-out
    }
    text name style=text.opt color=color.ink w=fill ellipsis nowrap
  }
}

// One picker column: heading, live count, scrolling option well.
def Picker(title, count) {
  col w=fill pad=16 style=fx.card {
    row align=center gap=8 pad=0,1,12,1 {
      text title style=text.label color=color.ochre
      spacer
      text count style=text.meta color=color.inkSoft nowrap
    }
    col w=fill h=180 gap=2 style=fx.well shadow=shadow.well pad=6 scroll \
        scrollbar=auto scrollbar-w=4 scrollbar-fg=color.ochre \
        scrollbar-bg=#8A5A1233 {
      slot
    }
  }
}

params {
  species           list(Pick) = []
  classes           list(Pick) = []
  backgrounds       list(Pick) = []
  species_count     text = ""
  classes_count     text = ""
  backgrounds_count text = ""
}

col w=fill gap=30 {
  // Hero — this component replaces the page heading. The seal is a fixed
  // stack so the hover-gated spinning arc never reflows the layout.
  col w=fill align=center gap=14 pad=44,0,6,0 {
    // Phones: the hero is over half the first screen; keep
    // the emblem, title and tagline closer together.
    when w<560 { pad=30,0,4,0 }
    // The gilt seal: two concentric rings stroked with a metallic gold
    // ramp (light → ochre → deep → light reads as metal, not as a flat
    // line), a jewel at the center, and a slow conic glint resting on
    // the rings. The pointer trades the resting glint for a fast one.
    stack w=84 h=84 animate=unfurl,600,once,ease-out {
      // warm bloom so the seal sits in the parchment instead of on it
      rect w=84 h=84 radius=999 \
          bg=radial(#F0D89626 0%, #D9A44114 52%, #D9A44100 74%)
      // outer ring
      rect w=84 h=84 radius=999 bg=none stroke-align=inside stroke-w=1.5 \
          stroke=linear(125, #F5E3B0 0%, #D9A441 38%, #8A5A12 62%, #E7C77A 100%)
      // inner ring — a shade brighter, heavier, strictly concentric
      rect self=center w=54 h=54 radius=999 bg=none stroke-align=inside \
          stroke-w=2 stroke=linear(125, #E7C77A 0%, #D9A441 46%, #F5E3B0 100%)
      // jewel in the middle
      rect self=center w=9 h=9 radius=999 \
          bg=radial(#F5E3B0 0%, #D9A441 55%, #8A5A12 100%)
      // resting glint: a faint conic sweep turning once every 9s
      rect w=84 h=84 radius=999 bg=none stroke-w=2.5 stroke-align=inside \
          stroke=conic(0, #D9A44100 0%, #F5E3B099 45%, #D9A44100 100%) \
          animate=spin,9000,loop,linear
      when hover {
        rect w=84 h=84 radius=999 bg=none stroke-w=3 stroke-align=inside \
            stroke=conic(0, #D9A44100 0%, #F5E3B0 45%, #D9A44100 100%) \
            animate=spin,2400,loop,linear
      }
    }
    text "GEN LEGEND" style=text.hero align-text=center \
        color=linear(180, #523305 0%, #8A5A12 55%, #523305 100%) \
        animate=unfurl,700,once,ease-out,150 {
      // 46u Cinzel at 4u tracking runs 362u wide — 93% of a
      // 390u screen, nearly touching its edges. 34u/2.6u lands
      // at ~243u: same presence, breathing room.
      when w<560 { size=34 tracking=2.6 }
    }
    text "Forge a legendary character for your next adventure." \
        style=text.tagline color=color.inkSoft align-text=center \
        animate=unfurl,700,once,ease-out,280
    // manuscript flourish: gilt rule, wax seal-dot, gilt rule
    row w=hug gap=8 align=center pad=4,0,0,0 \
        animate=unfurl,700,once,ease-out,400 {
      rect w=150 h=1 bg=linear(90, #8A5A1200 0%, #8A5A12CC 100%)
      rect w=6 h=6 radius=999 bg=color.wax
      rect w=150 h=1 bg=linear(90, #8A5A12CC 0%, #8A5A1200 100%)
    }
  }

  col w=fill gap=18 pad=24 style=fx.card \
      animate=unfurl,700,once,ease-out,700 {
    // Phones: 24u of side padding costs 12u of list width;
    // the card breathes better at 18u.
    when w<560 { pad=18 }
    // Filter — one field narrows all three lists at once; written on a
    // ruled line of the page, not inside a box.
    col w=fill gap=2 {
      row#filter h=42 pad=0,2 gap=12 align=center transition=160,ease-out {
        when hover { bg=color.raised }
        text "FILTER" style=text.label color=color.ochre nowrap
        text#query field=filter w=fill h=20 style=text.field color=color.ink
      }
      rect w=fill h=1 bg=#96794A opacity=0.9
    }

    row#pickers w=fill gap=16 align=start {
      when w<560 { axis=col }

      Picker title="SPECIES" count=param.species_count {
        each param.species #species
      }
      Picker title="CLASS" count=param.classes_count {
        each param.classes #classes
      }
      Picker title="BACKGROUND" count=param.backgrounds_count {
        each param.backgrounds #backgrounds
      }
    }

    // Asymmetric action row: the rule of the forge on the left, the loud
    // button on the right.
    row#action w=fill gap=16 align=center {
      // Phones: the hint (w=fill) was squeezed into a ~30u
      // column beside the 282u button and wrapped into a
      // 571u-tall skinny text wall — the action row was
      // 10× its content. Stacked, the hint gets its own
      // full-width line and the button sits under it.
      when w<560 { axis=col gap=12 }
      text "anything left on random is rolled for you" style=text.hint \
          color=color.inkSoft w=fill align-text=start
      row#generate w=hug h=56 pad=0,38 pack=center align=center \
          style=fx.button shadow=shadow.lift act=generate transition=160,ease-out {
        when hover { bg=color.waxDeep scale=1.03 }
        when pressed { opacity=0.85 }
        when focus-visible { stroke=color.ochre stroke-w=3 stroke-align=inside }
        text "GENERATE CHARACTER" style=text.button color=#F4ECD8 nowrap
      }
    }
  }
}
