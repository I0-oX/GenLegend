// Gen Legend — the whole Home surface: hero, forge card, generate.
// Compiled with @stencil-hq/slab@0.1.0 → app/static/slab/forge.*  (`make slab`);
// mounted by app/static/js/app.js in #view-home. The bridge feeds the option
// lists from GET /api/choices and answers the generate signal against
// POST /api/character/generate.
// Faces are registered by the bridge from app/static/fonts/ (OFL):
// Cinzel for chrome, Eagle Lake for the choices.
//
// Signals: pick carries "category|Name", filter narrows all three lists,
// generate forges the character. The legacy h2/p/tablet chrome is gone —
// this component IS the home page.
//
// House palette (shared by shell / footer / forge / sheet): night is the
// page ground, cave the panel surface, hairline lines instead of heavy
// borders, gold for accent, ember for the one loud action, bone/ash text.

tokens {
  color {
    night     #0C0A11   // page ground, wells
    cave      #171320   // card surface
    caveHover #241E31   // raised surface, option hover
    line      #342C47   // hairline borders
    gold      #E9C46A   // accent, labels, carets
    goldDeep  #B8933D   // resting accent stroke
    ember     #D7263D   // the loud one
    emberDeep #A31B2F   // pressed
    bone      #F4ECD8   // primary text
    ash       #A79DBB   // secondary text
  }
  text {
    hero    { family "Cinzel"; size 46; weight 700; tracking 4 }
    tagline { family "Cinzel"; size 15; weight 700; tracking 0.6 }
    chip    { family "Cinzel"; size 10; weight 700; tracking 1.8 }
    label   { family "Cinzel"; size 11; weight 700; tracking 2 }
    opt     { family "Eagle Lake"; size 15; weight 400 }
    meta    { family "Cinzel"; size 11; weight 700; tracking 1.4 }
    field   { family "Eagle Lake"; size 14; weight 400 }
    button  { family "Cinzel"; size 17; weight 700; tracking 2.4 }
    hint    { family "Cinzel"; size 11; weight 700; tracking 1.2 }
  }
  fx {
    card  { bg #171320; stroke #342C47; stroke-w 1; radius 16 }
    well  { bg #0C0A11; stroke #342C47; stroke-w 1; radius 10 }
    field { bg #0C0A11; stroke #342C47; stroke-w 1; radius 10 }
    pill  { bg #171320; stroke #342C47; stroke-w 1; radius 999 }
    button { bg linear(180, #E11F35 0%, #A31B2F 100%); radius 12 }
  }
  shadow {
    card 0,16,40,#00000080
    well inset,0,2,8,#00000059
    lift 0,12,30,#D7263D59
  }
}

// One hero fact: a small pill under the headline.
def FlavourChip(caption) {
  row w=hug h=28 pad=0,14 style=fx.pill align=center {
    text caption style=text.chip color=color.ash nowrap
  }
}

// One option row. The host assigns each item key "category|Name", so a single
// `pick` signal carries both the category and the choice.
def Pick(name="", picked=false) export {
  row w=fill pad=8,12 radius=8 align=center act=pick {
    when hover { bg=color.caveHover }
    when pressed { opacity=0.8 }
    when focus-visible { stroke=color.gold stroke-w=2 stroke-align=inside }
    when picked {
      bg=color.caveHover
      stroke=color.goldDeep
      stroke-w=1
      stroke-align=inside
      rect w=6 h=6 radius=999 bg=color.gold
    }
    text name style=text.opt color=color.bone w=fill ellipsis nowrap
  }
}

// One picker column: heading, live count, scrolling option well.
def Picker(title, count) {
  col w=fill pad=16 style=fx.card {
    row align=center gap=8 pad=0,1,12,1 {
      text title style=text.label color=color.gold
      spacer
      text count style=text.meta color=color.ash nowrap
    }
    col w=fill h=180 gap=2 style=fx.well shadow=shadow.well pad=6 scroll \
        scrollbar=auto scrollbar-w=4 scrollbar-fg=color.gold \
        scrollbar-bg=#E9C46A33 {
      slot
    }
  }
}

params {
  species           list(Pick) = []
  classes           list(Pick) = []
  backgrounds       list(Pick) = []
  species_count     text = ""
  classes_count     text = ""
  backgrounds_count text = ""
  match_hint        text = "type to narrow every option"
}

col w=fill gap=30 {
  // Hero — this component replaces the page heading.
  col w=fill align=center gap=14 pad=40,0,6,0 {
    text "GEN LEGEND" style=text.hero color=color.gold align-text=center
    text "Forge a legendary character for your next adventure." \
        style=text.tagline color=color.ash align-text=center
    row w=hug gap=8 {
      FlavourChip caption="SEEDED ROLLS"
      FlavourChip caption="SHAREABLE LINKS"
      FlavourChip caption="CHARACTER SHEETS"
    }
  }

  col w=fill gap=18 pad=24 style=fx.card shadow=shadow.card {
    // Filter — one field narrows all three lists at once.
    row#filter style=fx.field h=48 pad=0,16 gap=12 align=center {
      text "FILTER" style=text.label color=color.gold nowrap
      text#query field=filter w=fill h=20 style=text.field color=color.bone
      text param.match_hint style=text.hint color=color.ash nowrap
    }

    row#pickers w=fill gap=16 align=start {
      when w<560 { axis=col }

      Picker title="SPECIES" count=param.species_count {
        each param.species #species
      }
      Picker title="CLASS" count=param.classes_count {
        each param.classes #classes
      }
      Picker title="BACKGROUND" count=param.backgrounds_count {
        each param.backgrounds #backgrounds
      }
    }

    // Asymmetric action row: the rule of the forge on the left, the loud
    // button on the right.
    row#action w=fill gap=16 align=center {
      text "anything left on random is rolled for you" style=text.hint \
          color=color.ash w=fill align-text=start
      row#generate w=hug h=56 pad=0,38 pack=center align=center \
          style=fx.button shadow=shadow.lift act=generate {
        when hover { bg=linear(180, #F03048 0%, #B22033 100%) }
        when pressed { opacity=0.85 }
        when focus-visible { stroke=color.gold stroke-w=3 stroke-align=inside }
        text "GENERATE CHARACTER" style=text.button color=color.bone nowrap
      }
    }
  }
}
