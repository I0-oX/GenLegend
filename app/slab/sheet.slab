// Gen Legend — the character page bar: the reforge card (four selectors, the
// level stepper, generate, share) and the failure card. Compiled with
// @stencil-hq/slab@0.1.0 → app/static/slab/sheet.* (`make slab`); mounted by
// app/static/js/app.js, which answers every signal against
// POST /api/character/generate. The generated sheet HTML goes in the
// #character_result div that follows <gl-sheet> in index.html (slab 0.1.0
// cannot project host children).
//
// Signals: open_species / open_background / open_class / open_specialization
// toggle one dropdown (the bridge swaps param.field_options to match),
// pick carries "field|Name" from the option list, level_down / level_up
// re-forge immediately, generate applies the picked dimensions, share copies
// the canonical character URL.
//
// House palette (shared by shell / footer / forge / sheet): a papyrus page
// inside a bound-leather grimoire — vellum panels with procedural grain,
// ink-brown text, dark-gilt labels, sealing-wax red for the loud one.
// Motion: overlays unfurl as they drop, hovers pop via transitions, the wax
// dot stamps when a row becomes picked, FORGING… ticks only while busy.

tokens {
  color {
    parch      #DCC49A   // aged page ground (index.html matches)
    vellum     #F1E7CC   // card surface
    raised     #EBDFBC   // hover / picked rows
    well       #DFCB9E   // inset wells (option overlays)
    field      #EEE3C2   // input strips sit between card and well
    line       #96794A   // hairline borders
    ochre      #7C4F0E   // labels, values, carets (dark gold)
    ochreDeep  #5E3B0A   // resting accent stroke
    wax        #9E2B25   // the loud one (sealing wax)
    waxDeep    #7E1F1C   // pressed
    ink        #2B1E12   // primary text
    inkSoft    #483418   // secondary text
  }
  text {
    kicker { family "Cinzel"; size 14; weight 700; tracking 3 }
    label  { family "Cinzel"; size 12; weight 700; tracking 1.6 }
    opt    { family "Eagle Lake"; size 16; weight 400 }
    field  { family "Eagle Lake"; size 15; weight 400 }
    button { family "Cinzel"; size 14; weight 700; tracking 1.8 }
    level  { family "Cinzel"; size 17; weight 700 }
    hint   { family "Cinzel"; size 12; weight 700; tracking 1.2 }
  }
  fx {
    card  { bg linear(180, #F4EBD4 0%, #EADDBA 100%); stroke #96794A; stroke-w 1; radius 14; grain 0.10 }
    field { bg #EEE3C2; stroke #96794A; stroke-w 1; radius 10; grain 0.07 }
    well  { bg radial(#E4D2A6 0%, #D8C294 100%); stroke #96794A; stroke-w 1; radius 10; grain 0.11 }
    step  { bg #EEE3C2; stroke #96794A; stroke-w 1; radius 10; grain 0.07 }
    button { bg linear(180, #B5352F 0%, #7E1F1C 100%); radius 10 }
    ghost { stroke #96794A; stroke-w 1; radius 10 }
  }
  shadow {
    card 0,12,32,#3A2A1466
    well inset,0,2,8,#6E52303D
    lift 0,10,26,#8E242647
  }
}

// A dropdown drops onto the page: ink fades in as the list lays down.
anim unfurl {
  0% { opacity=0; scale=0.97 }
  100% { opacity=1; scale=1 }
}

// The forge hammers while a generate is in flight.
anim forging {
  0% { content="FORGING" }
  34% { content="FORGING." }
  67% { content="FORGING.." }
  100% { content="FORGING..." }
}

// The wax seal stamps down when a row becomes picked.
anim pop {
  0% { scale=0.2 }
  70% { scale=1.3 }
  100% { scale=1 }
}

// One dropdown option. The host keys every item "field|Name", so a single
// `pick` signal carries both the selector and the choice.
def Option(name="", picked=false) export {
  row w=fill h=34 pad=6,10 radius=6 align=center act=pick transition=160,ease-out {
    when hover { bg=color.raised scale=1.02 }
    when pressed { opacity=0.8 }
    when focus-visible { stroke=color.ochre stroke-w=2 stroke-align=inside }
    when picked {
      bg=color.vellum
      stroke=color.ochre
      stroke-w=1
      stroke-align=inside
      // The wax seal stamps down the moment the row becomes picked.
      rect w=6 h=6 radius=999 bg=color.wax animate=pop,300,once,ease-out
    }
    text name style=text.opt color=color.ink w=fill ellipsis nowrap
  }
}

// One selector: label and the picked value in a well. The option list is an
// anchored overlay at the card level (§6.10) so opening it does NOT grow
// the toolbar — attach= points at this field row's stable node key.
def Selector(caption, value, action) {
  col key=sel w=fill gap=5 {
    text caption style=text.label color=color.inkSoft
    row key=field w=fill h=44 pad=0,12 gap=8 align=center style=fx.field \
        act=action transition=160,ease-out {
      when hover { bg=color.raised stroke=color.ochre stroke-w=1.5 }
      when pressed { opacity=0.85 }
      when focus-visible { stroke=color.ochre stroke-w=2 stroke-align=inside }
      text value style=text.opt color=color.ink w=fill ellipsis nowrap
      text "▾" style=text.opt color=color.ochre
    }
  }
}

params {
  title          text = "Character Sheet"
  species        text = "Random"
  background     text = "Random"
  char_class     text = "Random"
  specialization text = "Random"
  open_species        bool = false        // exactly one selector opens at a time
  open_background     bool = false
  open_char_class     bool = false
  open_specialization bool = false
  field_options       list(Option) = []   // options for the open selector
  level          text = "1"
  busy           bool = false
  error_shown    bool = false
  error          text = ""
  share_status   text = ""
  share_error    bool = false
}

col key=page w=fill gap=14 {
  // The card is a stack: the flow column is the visible card; the four
  // option overlays are siblings AFTER it, so they paint above the actions
  // row and never contribute to the card's hug height.
  stack key=card w=fill {
    col key=flow w=fill pad=18 gap=14 style=fx.card shadow=shadow.card {
      // Toolbar head: the kicker on the left, the share status on the right.
      row key=head w=fill align=center gap=12 {
        text param.title style=text.kicker color=color.ochre w=fill
        when share_error {
          text param.share_status style=text.hint color=color.wax
        }
        when !share_error {
          text param.share_status style=text.hint color=color.inkSoft
        }
      }

      row key=selects w=fill gap=12 align=start {
        when w<860 { axis=col }
        Selector caption="SPECIES" value=param.species action=open_species
        Selector caption="BACKGROUND" value=param.background action=open_background
        Selector caption="CLASS" value=param.char_class action=open_class
        Selector caption="SPECIALIZATION" value=param.specialization action=open_specialization
      }

      row key=actions w=fill gap=16 align=center {
        when w<860 { axis=col }

        // Level stepper — both steps re-forge at once.
        row w=hug gap=8 align=center {
          row w=44 h=44 style=fx.step act=level_down align=center pack=center \
              transition=160,ease-out {
            when hover { bg=color.raised stroke=color.ochre stroke-w=1.5 scale=1.08 }
            when pressed { opacity=0.8 }
            text "-" style=text.level color=color.ink align-text=center
          }
          col w=hug align=center gap=2 {
            text "LEVEL" style=text.label color=color.inkSoft align-text=center
            text param.level style=text.level color=color.wax align-text=center
          }
          row w=44 h=44 style=fx.step act=level_up align=center pack=center \
              transition=160,ease-out {
            when hover { bg=color.raised stroke=color.ochre stroke-w=1.5 scale=1.08 }
            when pressed { opacity=0.8 }
            text "+" style=text.level color=color.ink align-text=center
          }
        }

        spacer

        when !busy {
          row w=hug h=44 pad=0,24 style=fx.button shadow=shadow.lift act=generate \
              align=center transition=160,ease-out {
            when hover { bg=linear(180, #C4403A 0%, #8E2426 100%) scale=1.04 }
            when pressed { opacity=0.85 }
            when focus-visible { stroke=color.ochre stroke-w=3 stroke-align=inside }
            text "GENERATE" style=text.button color=#F4ECD8 nowrap
          }
          row w=hug h=44 pad=0,24 style=fx.ghost act=share align=center \
              transition=160,ease-out {
            when hover { bg=color.raised stroke=color.ochre stroke-w=1.5 scale=1.04 }
            when pressed { opacity=0.8 }
            when focus-visible { stroke=color.ochre stroke-w=2 stroke-align=inside }
            text "SHARE" style=text.button color=color.ochre nowrap
          }
        }
        when busy {
          // Fixed width so the ticking dots never jiggle the row.
          row w=hug h=44 pad=0,24 align=center {
            text "FORGING..." style=text.button color=color.inkSoft w=150 \
                align-text=center animate=forging,1200,loop
          }
        }
      }
    }

    // Option overlays: one per selector, anchored under its field. The
    // bridge fills param.field_options for whichever selector is open;
    // gravity/collide keep the list inside the viewport. The unfurl is on
    // the overlay child itself (animate as a direct `when` patch is not
    // supported by slab 0.1.0).
    when open_species {
      col w=24% min-w=240 h=176 pad=6 gap=3 style=fx.well radius=12 \
          shadow=0,18,44,#3A2A14CC scroll \
          scrollbar=auto scrollbar-w=4 scrollbar-fg=color.ochre scrollbar-bg=#8A5A1233 \
          attach="page/card/flow/selects/Selector@0/sel/field" \
          gravity=below-start collide=none offset=0,6 \
          animate=unfurl,220,once,ease-out {
        when w<860 { w=fill }
        each param.field_options #option
      }
    }
    when open_background {
      col w=24% min-w=240 h=176 pad=6 gap=3 style=fx.well radius=12 \
          shadow=0,18,44,#3A2A14CC scroll \
          scrollbar=auto scrollbar-w=4 scrollbar-fg=color.ochre scrollbar-bg=#8A5A1233 \
          attach="page/card/flow/selects/Selector@1/sel/field" \
          gravity=below-start collide=none offset=0,6 \
          animate=unfurl,220,once,ease-out {
        when w<860 { w=fill }
        each param.field_options #option
      }
    }
    when open_char_class {
      col w=24% min-w=240 h=176 pad=6 gap=3 style=fx.well radius=12 \
          shadow=0,18,44,#3A2A14CC scroll \
          scrollbar=auto scrollbar-w=4 scrollbar-fg=color.ochre scrollbar-bg=#8A5A1233 \
          attach="page/card/flow/selects/Selector@2/sel/field" \
          gravity=below-start collide=none offset=0,6 \
          animate=unfurl,220,once,ease-out {
        when w<860 { w=fill }
        each param.field_options #option
      }
    }
    when open_specialization {
      col w=24% min-w=240 h=176 pad=6 gap=3 style=fx.well radius=12 \
          shadow=0,18,44,#3A2A14CC scroll \
          scrollbar=auto scrollbar-w=4 scrollbar-fg=color.ochre scrollbar-bg=#8A5A1233 \
          attach="page/card/flow/selects/Selector@3/sel/field" \
          gravity=below-start collide=none offset=0,6 \
          animate=unfurl,220,once,ease-out {
        when w<860 { w=fill }
        each param.field_options #option
      }
    }
  }

  when error_shown {
    col key=failure w=fill pad=16 gap=6 style=fx.card shadow=shadow.card {
      text "THE FORGE COULD NOT FINISH" style=text.label color=color.wax
      text param.error style=text.field color=color.ink w=fill
    }
  }
}
