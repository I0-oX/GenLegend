// Gen Legend — the page footer for the static slab frontend. Compiled with
// @stencil-hq/slab@0.1.0 → app/static/slab/footer.* (`make slab`); mounted
// by app/static/js/app.js as the last child of <body>, after the views.
// The links are signals: the bridge opens the three external URLs.
//
// Signals: open_about, open_wiki, open_julio.

tokens {
  color {
    leather   #2E1E10   // bound-leather chrome ground
    tooling   #A97B1D   // hairline borders (gilt tooling)
    gold      #D9A441   // accent
    goldDeep  #A97B1D   // resting accent
    cream     #EDE0BE   // primary text on leather
    parch     #B9A67C   // secondary text on leather
  }
  text {
    link { family "Cinzel"; size 12; weight 700; tracking 1.4 }
    by   { family "Cinzel"; size 11; weight 700; tracking 1.4 }
  }
}

// One footer separator, so the "|" inherits its padding from a row.
def Sep() {
  row w=hug pad=0,14 {
    text "|" style=text.link color=color.parch
  }
}

col w=fill {
  rect w=fill h=1 bg=color.tooling
  col w=fill pad=20 bg=color.leather align=center gap=8 {
    row w=hug align=center {
      row w=hug act=open_about transition=140,ease-out {
        when hover { scale=1.06 color=color.gold }
        when pressed { opacity=0.6 }
        text "About Us" style=text.link color=color.cream nowrap
      }
      Sep
      row w=hug act=open_wiki transition=140,ease-out {
        when hover { scale=1.06 color=color.gold }
        when pressed { opacity=0.6 }
        text "Lore Wiki" style=text.link color=color.cream nowrap
      }
      Sep
      row w=hug align=center gap=6 {
        text "By" style=text.by color=color.parch
        row w=hug act=open_julio transition=140,ease-out {
          when hover { scale=1.06 }
          when pressed { opacity=0.6 }
          text "Julio Toboso" style=text.by color=color.gold nowrap
        }
      }
    }
  }
}
