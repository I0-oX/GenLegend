// Gen Legend — the character sheet body: the content written ON the papyrus,
// from name to backstory. Compiled with @stencil-hq/slab@0.1.0
// (`make slab`) and fed by app/static/js/app.js from POST
// /api/character/generate's `sheet_data`.
//
// One contract, both ends: every param below is a field of that JSON, and
// every exported def is a list schema Python fills. Change one, change both.
//
// Voice: a page of a 14th-century bestiary under candlelight — Cinzel
// capitals for what is written on the frame, Eagle Lake for what is read,
// sealing-wax red for the loud numbers, a dark gilt for the labels, and a
// violet reserved for the spell work so magic reads as magic.
// No emoji and no colour anywhere: every symbol is line art declared below
// and painted in `current`, so the ink is one ink.
//
// The rail carries what a player checks mid-fight; the main column carries
// what a player reads. Under 760u the columns stack rail-first, because the
// armour class is wanted before the ancestry.

tokens {
  color {
    parch     #DCC49A   // page ground (index.html matches)
    vellum    #F1E7CC   // panel surface
    raised    #EBDFBC   // row hover
    well      #DFCB9E   // inset wells
    line      #96794A   // hairline
    ink       #2B1E12   // primary text
    inkSoft   #483418   // secondary text
    ochre     #7C4F0E   // labels, symbols (dark gold)
    gilt      #B98A2E   // gilded rule
    wax       #9E2B25   // sealing wax: the loud one
    waxDeep   #7E1F1C   // pressed
    arcane    #4A2E6B   // spell work: violet ink
  }
  text {
    name     { family "Cinzel"; size 34; weight 700; tracking 1.6; leading 1.1 }
    title    { family "Cinzel"; size 13; weight 700; tracking 3.4 }
    head     { family "Cinzel"; size 19; weight 700; tracking 2.6 }
    subhead  { family "Cinzel"; size 14; weight 700; tracking 2.2 }
    label    { family "Cinzel"; size 11; weight 700; tracking 1.7 }
    value    { family "Cinzel"; size 17; weight 700; tracking 0.4 }
    body     { family "Eagle Lake"; size 15; leading 1.55 }
    small    { family "Eagle Lake"; size 13.5; leading 1.5 }
    numeral  { family "Cinzel"; size 22; weight 700 }
    chip     { family "Eagle Lake"; size 14; leading 1.35 }
  }
  fx {
    panel   { bg linear(180, #F3EAD3 0%, #EBDFBB 100%); stroke #96794A; stroke-w 1; radius 10; grain 0.09 }
    tile    { bg #EFE5C7; stroke #A48952; stroke-w 1; radius 7; grain 0.06 }
    seal    { bg radial(#E4D2A6 0%, #D8C294 100%); stroke #96794A; stroke-w 1; radius 8; grain 0.1 }
    arcane  { bg linear(180, #E9E2D6 0%, #DED6C7 100%); stroke #4A2E6B; stroke-w 1; radius 10; grain 0.08 }
  }
  shadow {
    panel 0,8,24,#3A2A1447
    lift  0,6,18,#8E24263D
  }
}

// One run of prose: emphasis travels on the run, because slab has no
// cascade to give it a style. Not `weight=700`: a family registers ONE
// face (registerFont is keyed by family), so weight-700 runs measure
// against the bundled fallback's narrower metrics while the DOM paints
// synthesized Eagle Lake — the advance comes up ~7% short and every run
// after a bold one lands on top of it. Rubrication instead: sealing-wax
// red is the palette's "loud one", and `color` never touches measurement.
// slab 0.1.0 can paint italic only unconditionally, so flavour gets its
// own schema below and rules keep the wax alone.
def Run(content="", bold=false) export {
  span content {
    when bold { color=color.wax }
  }
}

// One paragraph. `para` lays its runs out as one wrapping line box. The
// `pad=3,0` (vertical,horizontal) is the paragraph rhythm: slab's `each`
// items take no gap from their container, so prose would otherwise butt
// line against line — the pad puts 6px between paragraphs inside a block.
def Para(runs=list(Run)) export {
  para style=text.body color=color.ink w=fill pad=3,0 { each runs }
}

// One flavour paragraph: italic, a shade quieter than the rules. The runs
// are plain `Run`s — slab's inheritance whitelist carries `italic` from the
// paragraph into every run (0.1.0's span rejects an `italic` attr of its
// own: it would paint the literal word).
def FlavorPara(runs=list(Run)) export {
  para style=text.small color=color.inkSoft italic w=fill pad=2,0 { each runs }
}

// One bullet: a gilt disc in the margin, the text beside it. The bottom
// pad keeps consecutive bullets apart (`each` items get no container gap).
def Bullet(runs=list(Run)) export {
  row w=fill pad=0,0,4,0 gap=9 align=start {
    rect w=5 h=5 radius=999 bg=color.ochre
    para style=text.body color=color.ink w=fill { each runs }
  }
}

// One table cell: a paragraph of runs.
def Cell(runs=list(Run)) export {
  para style=text.small color=color.ink w=fill { each runs }
}

// One table row: its cells share the width evenly.
def Row(cells=list(Cell)) export {
  row w=fill gap=12 pad=0,10 align=start {
    each cells
  }
}

// A bordered table (equipment, bag, spell slots) — a well of its own.
def Table(rows=list(Row)) export {
  col w=fill pad=8,0 gap=5 {
    each rows
  }
}

// One rail line of the ledger: its mark (when there is one), what it
// records, what it says, and a hairline beneath. Not a card — a manuscript
// keeps its accounts in ruled lines, not in boxes. Every child is `when`:
// slab paints unconditional children before conditional ones, so a mixed
// row would flip the mark to the end.
def Chip(glyph="", show_glyph=false, symbol="", caption="", value="", \
         kind="", show_mark=false, has_body=false) export {
  row w=fill pad=7,6 gap=9 align=center \
      stroke=color.line stroke-w=1 stroke-sides=b {
    when show_mark {
      row w=25 h=25 radius=999 bg=color.well stroke=color.line stroke-w=1 \
          pad=5,5 grain=0.1 {
        when show_glyph {
          icon glyph size=15 color=color.ochre
        }
        when !show_glyph {
          text symbol style=text.label color=color.ink
        }
      }
    }
    when has_body {
      col w=fill gap=1 {
        text caption style=text.label color=color.inkSoft w=fill ellipsis
        text value style=text.chip color=color.ink w=fill ellipsis
      }
    }
  }
}

// One ability score, a cell of the roll: its sigil, the score written out,
// the modifier beside it.
def Score(glyph="", caption="", value="", mod="") export {
  col w=fill pad=9,6 gap=3 align=center \
      stroke=color.line stroke-w=1 stroke-sides=b {
    icon glyph size=17 color=color.ochre
    row pack=center gap=4 align=center {
      text value style=text.numeral color=color.wax
      text mod style=text.label color=color.ochre
    }
    // Cinzel caps at text.label's 11/1.7 measure ~100px — wider than the
    // 87px grid cell — so CONSTITUTION/INTELLIGENCE hard-break mid-word.
    // size 9 / tracking 0.5 measures ~79px: one clean line.
    text caption style=text.label color=color.inkSoft align-text=center \
      size=9 tracking=0.5
  }
}

// One skill: proficiency disc, name and ability, bonus at the end. The
// hairline between them is the leader that keeps a long name's number in
// its own column, the way an index sets it.
def Skill(name="", attr="", bonus="", prof=false, expert=false) export {
  row w=fill h=24 gap=7 align=center {
    row w=11 h=11 radius=999 stroke=color.inkSoft stroke-w=1.2 {
      when prof { bg=color.ink stroke=color.ink }
      when expert { stroke=color.gilt stroke-w=2.4 }
    }
    text name style=text.small color=color.ink w=fill ellipsis
    text attr style=text.label color=color.ochre w=hug
    rect w=14 h=1 bg=color.line opacity=0.7
    text bonus style=text.subhead color=color.wax w=40 align-text=end
  }
}

// One saving throw: the same disc and leader, the bonus at the end.
def Save(name="", bonus="", prof=false, expert=false) export {
  row w=fill h=24 gap=7 align=center {
    row w=11 h=11 radius=999 stroke=color.inkSoft stroke-w=1.2 {
      when prof { bg=color.ink stroke=color.ink }
      when expert { stroke=color.gilt stroke-w=2.4 }
    }
    text name style=text.small color=color.ink w=fill ellipsis
    rect w=14 h=1 bg=color.line opacity=0.7
    text bonus style=text.subhead color=color.wax w=40 align-text=end
  }
}

// One attack roll line: the ability, the roll it adds, the proficient total.
def Attack(name="", base="", prof="") export {
  row w=fill h=24 gap=7 align=center {
    text name style=text.label color=color.ochre w=56
    text base style=text.small color=color.inkSoft w=fill align-text=end
    rect w=14 h=1 bg=color.line opacity=0.7
    text prof style=text.subhead color=color.wax w=40 align-text=end
  }
}

// The column the attack rolls are read under. The labels run at size 9 /
// tracking 1 so ABILITY fits its 56px column and TOTAL its 40px one —
// text.label's 11/1.7 clips them to "ABILIT"/"TOTA".
def AttackHead() export {
  row w=fill h=17 gap=7 align=center {
    text "ABILITY" style=text.label color=color.inkSoft w=56 \
      size=9 tracking=1
    text "BASE" style=text.label color=color.inkSoft w=fill align-text=end
    rect w=14 h=1 bg=none
    text "TOTAL" style=text.label color=color.inkSoft w=40 align-text=end \
      size=9 tracking=1
  }
}

// One line of a plain name list (Proficiencies, Tools, Languages).
def NamedItem(body="") export {
  text body style=text.small color=color.ink w=fill
}

// A titled block of plain names in the rail. The bottom pad (14, the
// rail's own gap) separates the panels — the three lists live together
// inside one `when`, which parents its children with gap 0.
def NamedList(title="", items=list(NamedItem)) export {
  col w=fill gap=4 pad=0,0,14,0 {
    text title style=text.head size=15 color=color.ink
    rect h=1 w=fill bg=color.line opacity=0.6
    each items
  }
}

// One group of known spell names, under its own level title.
def SpellGroup(title="", names=list(NamedItem)) export {
  col w=fill gap=2 {
    text title style=text.label color=color.arcane w=fill
    each names
  }
}

// One feature — a trait, a feat, an invocation: its name in capitals, the
// flavour line beneath it, its rules, then whatever nests under it.
// `has_*` are host-computed: slab's `when` reads a name, never an
// expression, and a nameless entry (plain prose under a branch)
// must not paint an empty line box. Every child is `when` because slab
// paints unconditional children first — a mixed entry would bury its
// name under its own prose. The root's bottom pad (6, this def's own gap)
// separates consecutive entries: `each` items take no container gap.
def Entry(name="", sub="", has_name=false, has_sub=false, \
          has_flavor=false, has_paras=false, has_bullets=false, \
          has_children=false, flavor=list(FlavorPara), \
          paras=list(Para), bullets=list(Bullet), entries=list(Entry)) export {
  col w=fill gap=6 pad=0,0,6,0 {
    when has_name {
      text name style=text.subhead color=color.ink w=fill
    }
    // `italic` on a leaf paints the literal word "italic" (0.1.0 quirk, see
    // FlavorPara) — the sub rides a `para`, the shape every flavour line
    // already uses, so it at least keeps its place and its small style.
    when has_sub {
      para style=text.small color=color.inkSoft italic w=fill { span sub }
    }
    // A `when` box parents its children with gap 0, so each list inside one
    // gets an explicit gapped col — otherwise every paragraph, bullet and
    // nested entry would butt against the next.
    when has_flavor {
      col w=fill gap=6 { each flavor }
    }
    when has_paras {
      col w=fill gap=6 { each paras }
    }
    when has_bullets {
      col w=fill gap=6 { each bullets }
    }
    when has_children {
      col w=fill gap=6 { each entries }
    }
  }
}

// One block of a section: an optional sub-heading, its flavour, its prose,
// its bullets, its table in a well, the notes under it, and its entries.
// The order is the reading order — every child guarded by a `when`, because
// slab paints unconditional children first and a mixed block would strand
// its heading below its own prose.
def Block(heading="", has_heading=false, has_flavor=false, \
          has_paras=false, has_bullets=false, has_tables=false, \
          has_notes=false, has_children=false, flavor=list(FlavorPara), \
          paras=list(Para), bullets=list(Bullet), tables=list(Table), \
          notes=list(Para), entries=list(Entry), seal=false) export {
  col w=fill gap=7 {
    when has_heading {
      text heading style=text.label color=color.ochre w=fill
    }
    // As in Entry: a `when` parents with gap 0, so each list inside carries
    // its own gapped col to keep the prose, bullets and entries breathing.
    when has_flavor {
      col w=fill gap=7 { each flavor }
    }
    when has_paras {
      col w=fill gap=7 { each paras }
    }
    when has_bullets {
      col w=fill gap=7 { each bullets }
    }
    // `seal` is host-computed: slab's `when` reads a name, never an
    // expression, so "this block has a table" ships beside the table.
    when seal {
      pad=9,11
      bg=linear(180, #E4D2A6 0%, #D8C294 100%)
      radius=8
      stroke=color.line
      stroke-w=1
    }
    when has_tables {
      col w=fill gap=7 { each tables }
    }
    when has_notes {
      col w=fill gap=7 { each notes }
    }
    when has_children {
      col w=fill gap=7 { each entries }
    }
  }
}

// One section of the main column — Species, Background, Class, Equipment,
// Backstory: its rubric numeral and title on a gilded rule, then its blocks.
// `show_title` ships with the section (always true) so the whole title row
// is conditional and keeps glyph → numeral → title left to right.
def Section(glyph="", show_glyph=false, numeral="", has_numeral=false, \
            title="", show_title=false, blocks=list(Block)) export {
  col w=fill gap=11 {
    col w=fill gap=5 {
      row w=fill gap=9 align=center {
        when show_glyph {
          icon glyph size=17 color=color.ochre
        }
        when has_numeral {
          text numeral style=text.subhead color=color.ochre w=hug
        }
        when show_title {
          text title style=text.head color=color.ink w=fill
        }
      }
      row w=fill gap=6 align=center {
        rect h=1 w=fill bg=color.gilt
        rect w=5 h=5 radius=999 bg=color.wax
        rect h=1 w=18 bg=color.gilt
      }
    }
    each blocks
  }
}

params {
  name          text = ""
  // slab paints unconditional children before conditional ones, so every
  // positional child of the page ships its own guard: the header keeps
  // name → title → seal line, the rail keeps PARTICULARS before the lists.
  has_name      bool = false
  title         text = ""
  // slab's `when` reads a name, never an expression, so "this panel has
  // content" is a flag the host ships beside the content it guards.
  has_title     bool = false
  show_seal     bool = false
  has_chips     bool = false
  has_scores    bool = false
  has_skills    bool = false
  has_saves     bool = false
  has_attacks   bool = false
  has_lists     bool = false
  has_magic     bool = false
  has_slots     bool = false
  has_spells    bool = false
  chips         list(Chip) = []
  scores        list(Score) = []
  skills        list(Skill) = []
  passive       text = ""
  saves         list(Save) = []
  attacks       list(Attack) = []
  lists         list(NamedList) = []
  magic         list(Chip) = []
  slots         list(Table) = []
  slots_title   text = "SPELL SLOTS"
  slot_notes    list(FlavorPara) = []
  spells        list(SpellGroup) = []
  sections      list(Section) = []
}

col#page w=fill pad=22,20 gap=20 {
  // Phones: the ground needs less frame so the ink gets more column.
  when w<560 { pad=16,12 gap=16 }
  // The header: the name in capitals, the title beneath it, then the seal
  // line that opens every page.
  col key=head w=fill gap=7 {
    when has_name {
      text param.name style=text.name color=color.wax w=fill {
        // A long name in 34u Cinzel runs off a 360u screen; 26u keeps the
        // capitals without buying an ellipsis.
        when w<560 { size=26 tracking=1.2 }
      }
    }
    when has_title {
      text param.title style=text.title color=color.ochre w=fill
    }
    when show_seal {
      row w=fill gap=7 align=center {
        rect h=1 w=14 bg=color.gilt
        rect w=5 h=5 radius=999 bg=color.wax
        rect h=1 w=fill bg=color.gilt opacity=0.7
        text "MEMENTO" style=text.label color=color.inkSoft opacity=0.7
        rect h=1 w=14 bg=color.gilt
      }
    }
  }

  // Rail first, then main; under 760u they stack so the fight numbers
  // arrive before the story.
  row key=body w=fill gap=20 align=start {
    when w<760 { axis=col }
    when w<560 { gap=14 }

    col key=rail w=300 min-w=260 gap=14 {
      when w<760 { w=fill }

      when has_chips {
        col key=particulars w=fill pad=11 gap=3 \
            style=fx.panel shadow=shadow.panel {
          text "PARTICULARS" style=text.head size=15 color=color.ink
          rect h=1 w=fill bg=color.line opacity=0.6
          each param.chips
        }
      }

      when has_scores {
        col key=scores w=fill pad=11 gap=7 style=fx.panel shadow=shadow.panel {
          text "ABILITIES" style=text.head size=15 color=color.ink
          rect h=1 w=fill bg=color.line opacity=0.6
          grid w=fill cols=fill,fill,fill gap=0,8 {
            each param.scores
          }
        }
      }

      when has_skills {
        col key=skills w=fill pad=11 gap=5 style=fx.panel shadow=shadow.panel {
          row w=fill gap=8 align=center {
            text "SKILLS" style=text.head size=15 color=color.ink w=fill
            text param.passive style=text.label color=color.inkSoft
          }
          rect h=1 w=fill bg=color.line opacity=0.6
          each param.skills
        }
      }

      when has_saves {
        col key=saves w=fill pad=11 gap=5 style=fx.panel shadow=shadow.panel {
          text "SAVING THROWS" style=text.head size=15 color=color.ink
          rect h=1 w=fill bg=color.line opacity=0.6
          each param.saves
        }
      }

      when has_attacks {
        col key=attacks w=fill pad=11 gap=5 style=fx.panel shadow=shadow.panel {
          text "ATTACK ROLLS" style=text.head size=15 color=color.ink
          rect h=1 w=fill bg=color.line opacity=0.6
          AttackHead
          each param.attacks
        }
      }

      when has_lists {
        // The three name panels sit together inside this one `when`
        // (gap 0), so they carry the rail's own gap in an inner col.
        col w=fill gap=14 { each param.lists }
      }

      when has_magic {
        col key=magic w=fill pad=11 gap=3 style=fx.panel shadow=shadow.panel {
          text "SPELLS & RESOURCES" style=text.head size=15 color=color.arcane
          rect h=1 w=fill bg=color.arcane opacity=0.5
          each param.magic
        }
      }

      when has_slots {
        col key=slots w=fill pad=11 gap=5 style=fx.panel shadow=shadow.panel {
          text param.slots_title style=text.head size=15 color=color.arcane
          rect h=1 w=fill bg=color.arcane opacity=0.5
          each param.slots
          each param.slot_notes
        }
      }

      when has_spells {
        col key=known w=fill pad=11 gap=9 style=fx.panel shadow=shadow.panel {
          text "KNOWN SPELLS" style=text.head size=15 color=color.arcane
          rect h=1 w=fill bg=color.arcane opacity=0.5
          each param.spells
        }
      }
    }

    col key=main w=fill gap=26 {
      when w<560 { gap=18 }
      each param.sections
    }
  }
}

// ------------------------------------------------------------------
// Icons — the sheet's whole vocabulary of symbols, as line art.
// Sourced from app/static/icons/ (game-icons.net, CC BY 3.0, see README)
// so the painter can emit them in `current` and the parchment keeps one ink.
// ------------------------------------------------------------------


icon acrobatic viewbox=512 {
  path "M140.488 19.31s-26.726 65.584-24.572 75.734c1.878 9.191 9.306.316 12.457 7.064c5.59 11.803 55.342 93.663 49.182 98.626c-1.558 1.36-39.38-.402-67.961-5.845c-52.49-9.998-94.822 2.352-77.039 42.21c26.177 58.653 133.15 154.14 97.89 183.602c-40.844 34.159 19.82 117.249 79.275 40.308c10.885-14.085 29.356-73.201-1.614-69.579c-37.447 4.38-14.128-30.491-14.128-30.491l23.345-29.92c12.96-1.9 134.534-21.449 134.534-21.449l-4.226-27.002l-174.475 20.25s-24.16-32.453-35.964-50.687c-9.37-11.474 62.005 4.88 76.388-10.522c19.968-21.276 7.601-43.88 7.601-43.88L155.35 69.201zm114.619 43.977l-62.759 39.419l16.081 28.897l114.931-58.86zm-124.743 78.84l-46.691 31.612l48.224 10.444l17.417-12.13zm175.08 24.496l-52.166 34.37l51.969 32.462l.058-21.93c51.869 12.43 140.22 48.13 126.472 191.26l23.908-73.889l27.884 33.386c-5.502-166.903-150.537-170.593-178.19-171.609zm-74.376 175.953l-19.91 25.873l110.89 14.697s18.638-17.84 15.035-18.976c-27.712-8.623-79.886-16.97-106.015-21.594"
