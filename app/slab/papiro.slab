// gl-papiro — the ancient papyrus sheet body, painted entirely in slab.
//
// Design rules (user: "no straight lines; an old papyrus is imperfect"):
//   * NO crisp ruled seams — strip structure comes from two wide, soft,
//     grainy band gradients at clashing angles with hand-jittered stops,
//     so no two strips are the same height and nothing is ruler-straight.
//   * Texture = slab grain (root + bands + a top veil), never SVG noise.
//   * Age = irregular mottle patches + foxing specks + water ring, all
//     radial/elliptical, rotated off-axis.
//   * app.js re-scatters the stain anchors (m1x…m6y) on every load,
//     so no two visits look the same.
//   * Age reads as TONE: deeper and paler patches over the sheet, edge
//     darkening and a vignette on top — no scorch marks (user: "forget
//     the burns, just darker and lighter parts like a real old sheet").
//
// Placement note: slab tuples (offset=) accept doc `param.` refs but not
// def-local props, so each scatterable mark is a literal child with its
// own param anchor — no list/each indirection.

tokens {
  fx {
    papiro  { bg radial(#E8D4A4 0%, #CFB183 50%, #B6976A 100%); grain 0.05 }
    // Strip tone: wide soft bands, irregular stop spacing, faint tilt,
    // grain so the transitions dither instead of reading as clean lines.
    tiras1  {
      bg linear(179.15,
        #FFF7E000 0%, #FFF7E01E 3.5%, #7A5A2A00 8%, #7A5A2A14 10.5%,
        #FFF7E000 15%, #FFF7E01B 19.5%, #7A5A2A00 24.5%, #7A5A2A12 27%,
        #FFF7E000 33%, #FFF7E01C 37.5%, #7A5A2A00 43%, #7A5A2A14 46.5%,
        #FFF7E000 52%, #FFF7E01A 57%, #7A5A2A00 63%, #7A5A2A12 66%,
        #FFF7E000 72%, #FFF7E01B 77.5%, #7A5A2A00 83%, #7A5A2A13 86.5%,
        #FFF7E000 92%, #FFF7E010 96.5%, #FFF7E000 100%);
      grain 0.035
    }
    tiras2  {
      bg linear(-178.85,
        #7A5A2A00 0%, #7A5A2A10 6.5%, #7A5A2A00 13.5%,
        #FFF7E000 21%, #FFF7E012 26%, #FFF7E000 32%,
        #7A5A2A00 41%, #7A5A2A10 47%, #7A5A2A00 54%,
        #FFF7E000 63%, #FFF7E011 69%, #FFF7E000 76%,
        #7A5A2A00 85%, #7A5A2A0F 91%, #7A5A2A00 100%);
      grain 0.03
    }
    sheen   { bg linear(112, #FFF7E000 22%, #FFF7E01A 46%, #FFF7E000 64%) }
    velo    { bg #FFF7E00D; grain 0.045,2 }
    anillo  { bg radial(#00000000 44%, rgba(96, 64, 26, 0.24) 60%, #00000000 77%) }
    foxing  { bg radial(rgba(74, 48, 18, 0.60) 0%, rgba(74, 48, 18, 0) 70%) }
    vig     { bg radial(#321A0A00 40%, #321A0A85 100%) }
  }
}

params {
  // mottle anchors — app.js scatters them per load
  m1x num = 180;  m1y num = 40
     m2x num = 560;  m2y num = 300
    m3x num = 120;  m3y num = 420
    m4x num = 640;  m4y num = -60
    // extra dark stains — deeper tone patches, re-aimed every visit
  m5x num = 40;   m5y num = -40
  m6x num = 880;  m6y num = 480
  }

stack w=fill h=fill style=fx.papiro {
  // strip tone, two clashing tilts -> organic interference, no hard lines
  rect w=fill h=fill style=fx.tiras1
  rect w=fill h=fill style=fx.tiras2

  // age scatter: oversized elliptical washes, rotated off-axis,
  // repositioned per load via param anchors
  rect w=940 h=660 rotate=-6 offset=param.m1x,param.m1y self=top-start \
       bg=radial(#76521F66 0%, #76521F00 74%) grain=0.025
  rect w=1080 h=740 rotate=8 offset=param.m2x,param.m2y self=top-start opacity=0.8 \
       bg=radial(#68461973 0%, #68461900 76%) grain=0.025
  rect w=880 h=680 rotate=-11 offset=param.m3x,param.m3y self=top-start opacity=0.7 \
       bg=radial(#FFF7D842 0%, #FFF7D800 74%) grain=0.02
  rect w=760 h=560 rotate=14 offset=param.m4x,param.m4y self=top-start opacity=0.75 \
       bg=radial(#5E401870 0%, #5E401800 72%) grain=0.025

  // deeper tone patches: the dark islands of an aged sheet
  rect w=820 h=600 rotate=-9 offset=param.m5x,param.m5y self=top-start opacity=0.85 \
       bg=radial(#4E361475 0%, #4E361400 74%) grain=0.025
  rect w=700 h=520 rotate=19 offset=param.m6x,param.m6y self=top-start opacity=0.8 \
       bg=radial(#573C1770 0%, #573C1700 72%) grain=0.025

  // water ring + soft diagonal sheen
  rect w=560 h=430 offset=600,240 self=top-start style=fx.anillo
  rect w=fill h=fill style=fx.sheen

  // foxing specks — clustered irregularly, never on a grid
  rect w=16 h=16 offset=290,180 self=top-start style=fx.foxing
  rect w=11 h=11 offset=360,246 self=top-start style=fx.foxing
  rect w=19 h=19 offset=880,120 self=top-start style=fx.foxing
  rect w=13 h=13 offset=1040,540 self=top-start style=fx.foxing
  rect w=9  h=9  offset=70,470  self=top-start style=fx.foxing
  rect w=15 h=15 offset=520,610 self=top-start style=fx.foxing
  rect w=10 h=10 offset=1180,320 self=top-start style=fx.foxing
  rect w=12 h=12 offset=190,660 self=top-start style=fx.foxing

  // top veil of grit over everything painted so far
  rect w=fill h=fill style=fx.velo


  // edge aging on top: vignette + top/bottom scorch fade
  rect w=fill h=fill style=fx.vig
  rect w=fill h=fill bg=linear(180, #321A0A55 0%, #321A0A00 13%)
  rect w=fill h=fill bg=linear(0, #321A0A4E 0%, #321A0A00 11%)
}
