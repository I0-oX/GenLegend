// gl-parchment — the parchment ground body, painted entirely in slab.
//
// Reference (user's photo, palette sampled from it): center #AE8C56,
// edges #74400F, dominant ochres #BA9752 #8F5F1E #AB884B #A97B38
// #C4A463 #B68C47 #6D3E0E #9A7439. The surface is CLOUD MOTTLED —
// soft masses at several scales, pale and dark — inside a strong dark
// frame on all four edges. No fibers dominate: detail = mottling.
//
// Procedural (user: "que tambien sea el pergamino dnd procedural"):
//   * Every mark carries its own anchor (d<i>x/d<i>y + the m washes);
//     app.js re-aims all {DETAIL} anchors per load, so the mottle never
//     repeats between visits.
//   * slab cannot position per-item marks from def/each (offset rejects
//     def-local props), so each mark is a literal child + doc param.
//   * No crisp ruled seams: strip structure = wide soft jittered bands
//     at clashing tilts; texture = slab grain only, amount kept low.

tokens {
  fx {
    // Warm ochre body: sampled center, deep umber at the corners.
    parchment { bg radial(#CDAB64 0%, #BE9851 42%, #9B7439 72%, #74400F 100%); grain 0.085 }

    // Strip tone: broad soft bands, irregular stops, faint tilt.
    tiras1  {
      bg linear(179.15,
        #E8D49A00 0%, #E8D49A12 3.5%, #8F5F1E00 8%, #8F5F1E14 10.5%,
        #E8D49A00 15%, #E8D49A10 19.5%, #8F5F1E00 24.5%, #8F5F1E12 27%,
        #E8D49A00 33%, #E8D49A11 37.5%, #8F5F1E00 43%, #8F5F1E14 46.5%,
        #E8D49A00 52%, #E8D49A0F 57%, #8F5F1E00 63%, #8F5F1E12 66%,
        #E8D49A00 72%, #E8D49A10 77.5%, #8F5F1E00 83%, #8F5F1E11 86.5%,
        #E8D49A00 92%, #E8D49A0A 96.5%, #E8D49A00 100%);
      grain 0.03
    }
    tiras2  {
      bg linear(-178.85,
        #8F5F1E00 0%, #8F5F1E12 6.5%, #8F5F1E00 13.5%,
        #E8D49A00 21%, #E8D49A0C 26%, #E8D49A00 32%,
        #8F5F1E00 41%, #8F5F1E12 47%, #8F5F1E00 54%,
        #E8D49A00 63%, #E8D49A0B 69%, #E8D49A00 76%,
        #8F5F1E00 85%, #8F5F1E10 91%, #8F5F1E00 100%);
      grain 0.025
    }
    // Cross-fiber layer: the second plant layer runs ~90 degrees to
    // the strips — near-vertical, barely there.
    tiras3  {
      bg linear(88.7,
        #E8D49A00 0%, #E8D49A06 5%, #8F5F1E00 11%, #8F5F1E05 15.5%,
        #E8D49A00 21%, #E8D49A05 26.5%, #8F5F1E00 33%, #8F5F1E04 37%,
        #E8D49A00 43%, #E8D49A06 48.5%, #8F5F1E00 55%, #8F5F1E05 59.5%,
        #E8D49A00 65%, #E8D49A05 71%, #8F5F1E00 78%, #8F5F1E04 82.5%,
        #E8D49A00 89%, #E8D49A05 94%, #8F5F1E00 100%);
      grain 0.02
    }

    // Warm pool of light over the middle of the sheet.
    pool   { bg radial(#F0D89400 18%, #F0D8941E 46%, #F0D89400 74%) }
    sheen  { bg linear(112, #E8D49A00 22%, #E8D49A0F 46%, #E8D49A00 64%) }
    velo   { bg #E8D49A06; grain 0.05,2 }

    // Old ring from a cup set on the sheet — thin, partial, off-center.
    anillo { bg radial(#00000000 44%, rgba(110, 70, 26, 0.15) 60%, #00000000 78%) }

    // Foxing: rust, not soot. Small, warm, soft-edged.
    foxing  { bg radial(rgba(140, 82, 30, 0.50) 0%, rgba(140, 82, 30, 0) 70%) }
    foxingL { bg radial(rgba(150, 96, 38, 0.28) 0%, rgba(150, 96, 38, 0) 72%) }

    // Corner shadow: warm and deep — the reference's dark frame.
    vig { bg radial(#5E330B00 46%, #5E330B6B 100%) }
  }
}

params {
  // broad wash anchors — app.js scatters them per load
  m1x num = 180;  m1y num = 40
  m2x num = 560;  m2y num = 300
  m3x num = 120;  m3y num = 420
  m4x num = 640;  m4y num = -60
  m5x num = 40;   m5y num = -40
  m6x num = 880;  m6y num = 480
  m7x num = 700;  m7y num = 200
  m8x num = 260;  m8y num = 620
  m9x num = 1020; m9y num = 120
  // cup ring drifts with the seed
  ringx num = 640; ringy num = 260
  // three tonal masses — position comes from the seed, so consecutive
  // sheets read as different pieces of parchment
  t1x num = 200; t1y num = 80
  t2x num = 700; t2y num = 420
  t3x num = 420; t3y num = 620
  // 244 detail marks (clouds, splotches, fibers, flecks) — d<i>x/d<i>y
  // every one re-aimed per load by app.js
  d0x num = 0; d0y num = 0  d1x num = 0; d1y num = 0
  d2x num = 0; d2y num = 0  d3x num = 0; d3y num = 0
  d4x num = 0; d4y num = 0  d5x num = 0; d5y num = 0
  d6x num = 0; d6y num = 0  d7x num = 0; d7y num = 0
