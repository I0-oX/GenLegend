// The ground develops from nothing as the sheet is written onto it —
// every creation (a fresh character, a fresh visit) plays this.
anim settle {
  0% { opacity=0 }
  100% { opacity=1 }
}

stack w=fill h=fill style=fx.parchment animate=settle,900,once,ease-out {
  // strip tone, two clashing tilts -> organic interference, no hard lines
  rect w=fill h=fill style=fx.tiras1
  rect w=fill h=fill style=fx.tiras2
  rect w=fill h=fill style=fx.tiras3

  // broad washes (m anchors, re-aimed per load)
  rect w=980 h=700 rotate=-6 offset=param.m1x,param.m1y self=top-start bg=radial(#A9702418 0%, #A9702418 30%, #A9702400 76%)
  rect w=1120 h=780 rotate=8 offset=param.m2x,param.m2y self=top-start bg=radial(#9A652214 0%, #9A652214 32%, #9A652200 76%)
  rect w=820 h=620 rotate=14 offset=param.m4x,param.m4y self=top-start bg=radial(#7E4C1833 0%, #7E4C1833 20%, #7E4C1800 76%)
  rect w=860 h=640 rotate=-9 offset=param.m5x,param.m5y self=top-start bg=radial(#8E5C1E2E 0%, #8E5C1E2E 20%, #8E5C1E00 76%)
  rect w=760 h=560 rotate=19 offset=param.m6x,param.m6y self=top-start bg=radial(#86521C29 0%, #86521C29 18%, #86521C00 76%)
  rect w=1040 h=740 rotate=-15 offset=param.m8x,param.m8y self=top-start bg=radial(#8A5A1E14 0%, #8A5A1E14 34%, #8A5A1E00 76%)
  rect w=900 h=620 rotate=6 offset=param.m9x,param.m9y self=top-start bg=radial(#8A5A1E12 0%, #8A5A1E12 32%, #8A5A1E00 76%)
  rect w=720 h=540 rotate=-11 offset=param.m3x,param.m3y self=top-start bg=radial(#FFEFC023 0%, #FFEFC023 30%, #FFEFC000 76%)
  rect w=660 h=480 rotate=-24 offset=param.m7x,param.m7y self=top-start bg=radial(#FFEFC01B 0%, #FFEFC01B 30%, #FFEFC000 76%)

  // Per-seed tonal masses: a dark age blot, a bleached patch, a warm
  // soak — each anchor comes from the seed, so two creations never
  // share the same tone.
  rect w=1150 h=860 rotate=-12 offset=param.t1x,param.t1y self=top-start opacity=0.10 bg=radial(#4E2A08 0%, #4E2A08 18%, #4E2A0800 74%)
  rect w=980 h=760 rotate=9 offset=param.t2x,param.t2y self=top-start opacity=0.11 bg=radial(#F3E1B4 0%, #F3E1B4 16%, #F3E1B400 72%)
  rect w=900 h=700 rotate=-19 offset=param.t3x,param.t3y self=top-start opacity=0.08 bg=radial(#C08A34 0%, #C08A34 20%, #C08A3400 76%)

  // cup ring, off-center and not quite closed
  rect w=520 h=400 offset=param.ringx,param.ringy self=top-start style=fx.anillo

  // ---- the procedural mottle: clouds, splotches, stains, fibers
  rect w=632 h=407 rotate=-29 offset=param.d0x,param.d0y self=top-start bg=radial(#A97B3860 0%, #A97B3860 26%, #A97B3800 70%)
  rect w=584 h=480 rotate=-19 offset=param.d1x,param.d1y self=top-start bg=radial(#BA975260 0%, #BA975260 29%, #BA975200 70%)
  rect w=660 h=420 rotate=-21 offset=param.d2x,param.d2y self=top-start bg=radial(#BA975260 0%, #BA975260 29%, #BA975200 70%)
  rect w=433 h=404 rotate=2 offset=param.d3x,param.d3y self=top-start bg=radial(#B68C476B 0%, #B68C476B 19%, #B68C4700 70%)
  rect w=482 h=427 rotate=15 offset=param.d4x,param.d4y self=top-start bg=radial(#A97B386B 0%, #A97B386B 21%, #A97B3800 70%)
  rect w=451 h=480 rotate=-9 offset=param.d5x,param.d5y self=top-start bg=radial(#AB884B6B 0%, #AB884B6B 24%, #AB884B00 70%)
  rect w=684 h=512 rotate=13 offset=param.d6x,param.d6y self=top-start bg=radial(#A97B387A 0%, #A97B387A 26%, #A97B3800 70%)
  rect w=584 h=497 rotate=20 offset=param.d7x,param.d7y self=top-start bg=radial(#A97B386B 0%, #A97B386B 25%, #A97B3800 70%)
  rect w=557 h=565 rotate=-25 offset=param.d8x,param.d8y self=top-start bg=radial(#B68C4760 0%, #B68C4760 29%, #B68C4700 70%)
  rect w=505 h=425 rotate=28 offset=param.d9x,param.d9y self=top-start bg=radial(#B68C477A 0%, #B68C477A 29%, #B68C4700 70%)
