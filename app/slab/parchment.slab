  rect w=432 h=559 rotate=8 offset=param.d15x,param.d15y self=top-start bg=radial(#B68C4760 0%, #B68C4760 20%, #B68C4700 70%)
  rect w=779 h=559 rotate=1 offset=param.d16x,param.d16y self=top-start bg=radial(#B68C476B 0%, #B68C476B 27%, #B68C4700 70%)
  rect w=545 h=423 rotate=21 offset=param.d17x,param.d17y self=top-start bg=radial(#BA97527A 0%, #BA97527A 30%, #BA975200 70%)
  rect w=678 h=534 rotate=10 offset=param.d18x,param.d18y self=top-start bg=radial(#AB884B6B 0%, #AB884B6B 29%, #AB884B00 70%)
  rect w=658 h=531 rotate=12 offset=param.d19x,param.d19y self=top-start bg=radial(#AB884B7A 0%, #AB884B7A 17%, #AB884B00 70%)
  rect w=432 h=353 rotate=27 offset=param.d20x,param.d20y self=top-start bg=radial(#A97B386B 0%, #A97B386B 15%, #A97B3800 70%)
  rect w=486 h=446 rotate=-16 offset=param.d21x,param.d21y self=top-start bg=radial(#AB884B7A 0%, #AB884B7A 25%, #AB884B00 70%)
  rect w=260 h=176 rotate=-18 offset=param.d22x,param.d22y self=top-start bg=radial(#7E501752 0%, #7E501752 24%, #7E501700 70%)
  rect w=184 h=223 rotate=-1 offset=param.d23x,param.d23y self=top-start bg=radial(#8F5F1E6B 0%, #8F5F1E6B 21%, #8F5F1E00 70%)
  rect w=395 h=321 rotate=-23 offset=param.d24x,param.d24y self=top-start bg=radial(#7E50176B 0%, #7E50176B 14%, #7E501700 70%)
  rect w=198 h=189 rotate=-51 offset=param.d25x,param.d25y self=top-start bg=radial(#8F5F1E78 0%, #8F5F1E78 13%, #8F5F1E00 70%)
