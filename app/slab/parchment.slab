  rect w=fill h=fill style=fx.sheen
  rect w=fill h=fill style=fx.pool

  // fine grit veil
  rect w=fill h=fill style=fx.velo

  // ---- the dark frame: four edges sinking into umber (reference)
  rect w=fill h=fill style=fx.vig
  rect w=fill h=fill bg=linear(180, #5E330BA3 0%, #5E330B00 10%)
  rect w=fill h=fill bg=linear(0,   #5E330BAC 0%, #5E330B00 10%)
